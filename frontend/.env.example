# =============================================================================
# AutoInsight AI — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# =============================================================================

# ── Convex (Required) ─────────────────────────────────────────────────────
# Your Convex deployment URL. Get this from: https://dashboard.convex.dev
# Default is set in convex.json; override here if needed
NEXT_PUBLIC_CONVEX_URL=https://sleek-herring-766.convex.cloud

# ── OpenRouter API Key (Required for LLM) ─────────────────────────────────
# Get your free API key from: https://openrouter.ai/keys
# Models used: qwen/qwen3-coder:free (primary), meta-llama/llama-4-maverick:free (fallback)
# Recommended: Sign up at openrouter.ai → Create API key → Paste below
# OpenRouter charges $0 for many free models, some paid models add small fees
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# ── OpenRouter is the Sole LLM Provider ──────────────────────────────────
# AutoInsight AI uses OpenRouter exclusively with 2-tier fallback:
# Primary:   qwen/qwen3-coder:free
# Fallback:  meta-llama/llama-4-maverick:free
# Both models are completely free. No Groq or other providers needed.

# ── Backend API URL (Optional — for local development only) ───────────────
# Only needed if running the Python FastAPI backend locally
# In production, Vercel serves the frontend and Convex handles the backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App URL (Optional) ────────────────────────────────────────────────────
# Used in HTTP-Referer header for OpenRouter API calls
# In production this should be your Vercel deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
