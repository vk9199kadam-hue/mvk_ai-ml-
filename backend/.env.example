# =============================================================================
# AutoInsight AI — Backend Environment Variables
# =============================================================================
# NOTE: The backend (FastAPI + Python) is for local development only.
# In production, Convex handles all backend logic (database, LLM, storage).
# This file is kept for reference when running the backend locally.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=AutoInsight AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL — Local Dev Only) ────────────────────────────────
DATABASE_URL=postgresql://autoinsight:changeme@localhost:5432/autoinsight
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoinsight
DB_USER=autoinsight
DB_PASSWORD=changeme

# ── Redis (Cache + Task Queue — Local Dev Only) ───────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── S3 File Storage (MinIO — Local Dev Only) ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autoinsight-files
S3_REGION=us-east-1
S3_SECURE=false

# ── LLM Provider (mirrors frontend .env.local) ────────────────────────────
# OpenRouter is the primary provider
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
# Groq is the fallback provider ($0/month free tier)
GROQ_API_KEY=gsk_your-groq-api-key-here

# ── JWT Authentication ───────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── Pipeline ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
PIPELINE_TIMEOUT_SECONDS=300
CHUNK_SIZE_MB=10
PARQUET_COMPRESSION=snappy

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Celery (Async Task Queue) ────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
